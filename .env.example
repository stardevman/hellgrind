# Ücretsiz aşama: her şey yerel ve DRY_RUN=1 -> hiçbir ücretli API çağrılmaz.
# Bu dosyadaki değerler config.py varsayılanlarıyla aynıdır; kopyalayıp .env yapın.
DATABASE_URL=postgresql+psycopg://hg:hg@postgres:5432/hellgrind
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT_URL=http://minio:9000
# Tarayıcının MinIO'ya eriştiği adres (imzalı video URL'leri bununla üretilir)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=hellgrind-media

# 1 = yerel sağlayıcı, sıfır harcama. Açık onay olmadan 0 yapma.
DRY_RUN=1
# 0.1 = isteklerin %10'u geçici hata verir (yeniden deneme testi için)
DRY_RUN_FAIL_RATE=0.0
# Bilerek bozuk (siyah/donmuş) klip oranı: Quality Gate'i sınamak için
DRY_RUN_DEFECT_RATE=0.12
# Sahte CLIP skor dağılımı
DRY_RUN_SCORE_MEAN=0.89
DRY_RUN_SCORE_SD=0.05
LOCAL_RENDER_FPS=24

# hard = elenen dosyayı sil, quarantine = quarantine/ önekine taşı
PURGE_MODE=quarantine
GEN_CONCURRENCY=3
# espeak (ücretsiz, Türkçe) | tone
TTS_ENGINE=espeak
# rules (ücretsiz) | llm (ücretli)
HERMES_MODE=rules

# Kalite skoru: auto (ücretsiz modda sahte, ücretli modda gerçek) | dry (her zaman sahte; ücretli modda üretim başlamaz)
# | real (her zaman gerçek: OpenCLIP + YuNet/SFace, imajdaki yerel modellerle, ücretsiz)
QUALITY_SCORER=auto
# Birleşik skorda yüz kimliğinin payı (karede yüz görünüyorsa)
SCORE_FACE_WEIGHT=0.4
# Prompt çevirisi: görüntü modelleri İngilizce istemi izler. auto (yalnızca ücretli modda, Türkçe tarifler yerel
# opus-mt-tr-en modeliyle İngilizceye çevrilir; ücretsiz) | on (her zaman) | off (hiç; senaryoyu İngilizce yazın)
PROMPT_TRANSLATION=auto

# Ücretli entegrasyonlar: şimdilik boş kalsın. DRY_RUN=1 iken hiçbiri okunmaz.
# Video motoru MiniMax H3. Platform: runpod (varsayılan; RunPod Serverless, modeller Network Volume'da) | vast (deneysel,
# kapalı). Kurulum: backend/runpod/README.md.
H3_PLATFORM=runpod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_NETWORK_VOLUME_ID=
# Volume'un ve uç noktanın veri merkezi. İzinli: CA-MTL-1, CA-MTL-2, CA-MTL-3; EUR-NO-1 ve EUR-IS-* yalnızca
# H3_ALLOW_NORDIC=true iken (izinli liste: backend/app/core/regions.py)
RUNPOD_DATACENTER=CA-MTL-1
H3_ALLOW_NORDIC=false
RUNPOD_GPU_TYPES=RTX 5090,RTX PRO 6000
# Worker son işten sonra bu kadar saniye açık kalır (faturalanır)
RUNPOD_IDLE_TIMEOUT_S=60
# RunPod bakiyesi bunun altındaysa yeni iş başlamaz ($)
RUNPOD_MIN_BALANCE_USD=10
# H3 DiT türü: fp8_scaled (cu128 worker imajı) | int8_convrot (cu130 torch'lu imaj gerekir)
H3_UNET_VARIANT=fp8_scaled
# --- vast.ai (deneysel, varsayılan kapalı; H3_PLATFORM=vast) ---
# Ücretli kilidin anahtarı vast.ai API anahtarıdır (makineyi o faturalar; boşta durdurma ve otomatik başlatma da onunla).
VAST_API_KEY=
VAST_INSTANCE_ID=
# comfyui (varsayılan) | sglang (deneysel)
H3_BACKEND=comfyui
# SGLang FL2VA sunucusu ya da ComfyUI adresi. ComfyUI makinede 127.0.0.1'de çalışır: SSH tüneliyle
# (ssh -N -L 8188:127.0.0.1:8188 -p PORT root@IP; adres http://host.docker.internal:8188) ya da portalın kimlik doğrulamalı
# vekiliyle erişin; açık port bırakmayın.
H3_ENDPOINT_URL=
# Ref2VA sunucusu (SGLang). ComfyUI'de boş bırakılırsa aynı sunucu (r2v iş akışı) kullanılır.
H3_REF_ENDPOINT_URL=
# Portal belirteci (OPEN_BUTTON_TOKEN ya da WEB_PASSWORD); SSH tünelinde gerekmez
H3_API_KEY=
H3_MODEL=MiniMaxAI/MiniMax-H3
# Klip meta verisine yazılır, ör. "fl2va pruned int8 convrot + turbo v4"
H3_MODEL_REVISION=
# Sunucudaki kurulumla aynı olmalı: SGLang turbo LoRA 9 (8 değerlendirme), temel 20-50
H3_STEPS=9
# Kuyruk bu kadar dakika boşsa makine durdurulur (0: kapalı); iş gelince durmuş makineyi başlat (true/false)
H3_IDLE_STOP_MINUTES=10
H3_AUTO_START=false
# Sunucu sertifikası: verify (doğrula) | pin (ilk başarılı bağlantıda SHA-256 parmak izini sabitle; panelden kiralanan
# makinenin portalı kendinden imzalıdır, orada pin yazılır) | off (doğrulama yok)
H3_TLS_MODE=verify
# Yedek makine (otomatik başlatma başarısız olursa): ask (her zaman sor) | auto (fiyat tavanı altındaysa sormadan) | off
H3_REPLACE_MODE=ask
# Yeni ve yedek makine koşulları. RAM: yalnızca H3 ~94 GB kullandı, Qwen-Image ~30 GB ekler (en az 96);
# disk: modeller ~105 GB (en az 150); indirme Mbps (1000 = 1 Gbps)
H3_MAX_DPH=0.95
H3_MIN_RAM_GB=128
H3_MIN_DISK_GB=200
H3_MIN_INET_MBPS=1000
# Boşsa eski makinenin GPU'su (ilk makinede RTX 5090)
H3_GPU_NAME=
H3_BOX_IMAGE=vastai/base-image:@vastai-automatic-tag
# Boşsa backend/vast/setup.sh kiralama isteğine gömülür
H3_SETUP_SCRIPT_URL=
# setup.sh'nin kurduğu storyboard görsel modeli (Apache 2.0): qwen-image-2512 | flux-schnell | none
H3_IMAGE_MODEL=qwen-image-2512
# fal.ai isteğe bağlıdır: Seedance (seçilen çekimler), Flux kareleri, previs aktarımı, dudak senkronu
FAL_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Ücretli model ve uç nokta kimlikleri (panelin Ayarlar sayfasından da düzenlenir; fal.ai model sayfalarıyla doğrula)
FAL_FLUX_ENDPOINT=fal-ai/flux-lora
FAL_WAN_ENDPOINT=fal-ai/wan/v2.2-a14b/image-to-video
FAL_SEEDANCE_ENDPOINT=bytedance/seedance-2.0/fast/image-to-video
FAL_LIPSYNC_ENDPOINT=fal-ai/sync-lipsync/v2/pro
FAL_WAN_V2V_ENDPOINT=fal-ai/wan/v2.2-a14b/video-to-video
# Karakterin durağan referans görseli varsa ilk kare ve storyboard bu modelle, görselden çizilir (görsel başına ücret)
FAL_KONTEXT_ENDPOINT=fal-ai/flux-pro/kontext
ELEVENLABS_MODEL=eleven_multilingual_v2
HERMES_MODEL=claude-sonnet-5-5
