# Kademe 1: her şey yerel ve DRY_RUN=1 -> hiçbir ücretli API çağrılmaz.
DATABASE_URL=postgresql+psycopg://hg:hg@postgres:5432/hellgrind
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=hellgrind-media

# 1 = sahte sağlayıcı, sıfır harcama. Kademe 2'ye kadar kapatma.
DRY_RUN=1
# Sahte üretim süresi (saniye)
DRY_RUN_LATENCY_S=0.3
# 0.1 = isteklerin %10'u geçici hata verir (yeniden deneme testi için)
DRY_RUN_FAIL_RATE=0.0
# Sahte CLIP skor dağılımı
DRY_RUN_SCORE_MEAN=0.87
DRY_RUN_SCORE_SD=0.05

# hard = elenen dosyayı sil, quarantine = karantina klasörüne taşı
PURGE_MODE=quarantine
GEN_CONCURRENCY=5

# Kademe 2'de doldurulacak (şimdilik boş kalsın)
FAL_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
PINECONE_API_KEY=
