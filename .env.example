# Ücretsiz aşama: her şey yerel ve DRY_RUN=1 -> hiçbir ücretli API çağrılmaz.
# Bu dosyadaki değerler config.py varsayılanlarıyla aynıdır; kopyalayıp .env yapın.
DATABASE_URL=postgresql+psycopg://hg:hg@postgres:5432/hellgrind
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT_URL=http://minio:9000
# Tarayıcının MinIO'ya eriştiği adres (imzalı video URL'leri bununla üretilir)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=hellgrind-media

# 1 = yerel sağlayıcı, sıfır harcama. Açık onay olmadan 0 yapma.
DRY_RUN=1
# 0.1 = isteklerin %10'u geçici hata verir (yeniden deneme testi için)
DRY_RUN_FAIL_RATE=0.0
# Bilerek bozuk (siyah/donmuş) klip oranı: Quality Gate'i sınamak için
DRY_RUN_DEFECT_RATE=0.12
# Sahte CLIP skor dağılımı
DRY_RUN_SCORE_MEAN=0.89
DRY_RUN_SCORE_SD=0.05
LOCAL_RENDER_FPS=24

# hard = elenen dosyayı sil, quarantine = quarantine/ önekine taşı
PURGE_MODE=quarantine
GEN_CONCURRENCY=3
# espeak (ücretsiz, Türkçe) | tone
TTS_ENGINE=espeak
# rules (ücretsiz) | llm (ücretli)
HERMES_MODE=rules

# Kalite skoru: auto (ücretsiz modda sahte, ücretli modda gerçek) | dry (her zaman sahte; ücretli modda üretim başlamaz)
# | real (her zaman gerçek: OpenCLIP + YuNet/SFace, imajdaki yerel modellerle, ücretsiz)
QUALITY_SCORER=auto
# Birleşik skorda yüz kimliğinin payı (karede yüz görünüyorsa)
SCORE_FACE_WEIGHT=0.4
# Prompt çevirisi: görüntü modelleri İngilizce istemi izler. auto (yalnızca ücretli modda, Türkçe tarifler yerel
# opus-mt-tr-en modeliyle İngilizceye çevrilir; ücretsiz) | on (her zaman) | off (hiç; senaryoyu İngilizce yazın)
PROMPT_TRANSLATION=auto

# Ücretli entegrasyonlar: şimdilik boş kalsın. DRY_RUN=1 iken hiçbiri okunmaz.
FAL_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Ücretli model ve uç nokta kimlikleri (panelin Ayarlar sayfasından da düzenlenir; fal.ai model sayfalarıyla doğrula)
FAL_FLUX_ENDPOINT=fal-ai/flux-lora
FAL_WAN_ENDPOINT=fal-ai/wan/v2.2-a14b/image-to-video
FAL_SEEDANCE_ENDPOINT=bytedance/seedance-2.0/fast/image-to-video
FAL_LIPSYNC_ENDPOINT=fal-ai/sync-lipsync/v2/pro
FAL_WAN_V2V_ENDPOINT=fal-ai/wan/v2.2-a14b/video-to-video
ELEVENLABS_MODEL=eleven_multilingual_v2
HERMES_MODEL=claude-sonnet-5-5
